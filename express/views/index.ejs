    <thead>
      <tr>
        <th>Employee</th>
        <th>Title</th>
        <th>Status</th>
        <th>Role</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      </tbody>
  </table>
  <script src="/script.js"></script>
</body>
</html>