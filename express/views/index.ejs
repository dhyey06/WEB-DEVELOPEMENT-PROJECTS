<!DOCTYPE html>
<html>
<head>
  <title>Employee List</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Employees</h1>
  <p>This is a list of all employees. You can add new employees, edit or delete existing ones.</p>
